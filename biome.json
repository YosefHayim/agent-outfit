{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,js,mjs,json,jsonc}",
      "*.{ts,tsx,js,mjs,json,jsonc}",
      "!src/skills/makePromoVideo/scripts/assembleCut.mjs"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off", "noNestedTernary": "error" },
      "suspicious": { "noFocusedTests": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["src/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["commander", "@clack/prompts", "picocolors", "effect", "@effect/*"],
                    "message": "Hooks run without dependencies: import only node:*, src/hooks/lib/*, and the feature's own lib/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
