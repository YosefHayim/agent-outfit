{
  "name": "agent-outfit",
  "version": "0.1.0",
  "description": "TypeScript CLI that installs, updates, diagnoses, configures, and removes a coding-agent setup: skills, guard hooks, agent configuration, workflow templates, and status lines for Claude Code, Codex, Grok, Kimi, Kiro, and more.",
  "type": "module",
  "bin": {
    "agent-outfit": "dist/src/cli/main.js"
  },
  "files": [
    "dist",
    "src/skills",
    "src/templates",
    "README.md",
    "LICENSE",
    "!src/skills/**/node_modules",
    "!src/skills/**/node_modules/**",
    "!dist/src/scripts"
  ],
  "scripts": {
    "cli": "tsx src/cli/main.ts",
    "prepare": "husky",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/src/cli/main.js',0o755)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "style": "tsx src/scripts/reportCodeStyle.ts",
    "style:guide": "tsx src/scripts/reportRuleCards.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "biome ci . && tsc --noEmit && pnpm style && pnpm style:guide . && vitest run && pnpm build && pnpm generate-readme:check",
    "prepublishOnly": "npm run build",
    "generate-readme": "tsx src/scripts/generateReadme.ts",
    "generate-readme:check": "tsx src/scripts/generateReadme.ts --check"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "grok",
    "skills",
    "hooks",
    "cli",
    "context-window",
    "handoff",
    "autonomous",
    "agent",
    "ai",
    "developer-tools",
    "macos",
    "svg",
    "image-to-code"
  ],
  "author": "Yosef Hayim Sabag",
  "license": "MIT",
  "homepage": "https://github.com/YosefHayim/agent-outfit#readme",
  "bugs": {
    "url": "https://github.com/YosefHayim/agent-outfit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YosefHayim/agent-outfit.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@effect/cli": "0.76.0",
    "@effect/platform": "0.97.2",
    "@effect/platform-node": "0.108.0",
    "effect": "3.22.2",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@effect/vitest": "0.30.0",
    "@types/node": "22.20.0",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
